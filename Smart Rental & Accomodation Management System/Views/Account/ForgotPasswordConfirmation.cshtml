@{
    ViewData["Title"] = "Check your email";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="mb-4">Check your email</h1>
        <div class="alert alert-info">
            If an account with that email exists and is confirmed, we've sent a password reset link to it.
        </div>
        <a asp-action="Login" class="btn btn-primary">Back to log in</a>
    </div>
</div>

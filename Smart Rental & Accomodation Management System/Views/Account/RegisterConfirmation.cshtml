@{
    ViewData["Title"] = "Check your email";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="mb-4">Check your email</h1>
        <div class="alert alert-info">
            We've sent a confirmation link to <strong>@ViewData["Email"]</strong>. Click the link in that
            email to activate your account before logging in.
        </div>
        <a asp-action="Login" class="btn btn-primary">Go to log in</a>
    </div>
</div>

@model bool
@{
    ViewData["Title"] = "Confirm email";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="mb-4">Confirm email</h1>
        @if (Model)
        {
            <div class="alert alert-success">Your email has been confirmed. You can now log in.</div>
        }
        else
        {
            <div class="alert alert-danger">This confirmation link is invalid or has already been used.</div>
        }
        <a asp-action="Login" class="btn btn-primary">Go to log in</a>
    </div>
</div>

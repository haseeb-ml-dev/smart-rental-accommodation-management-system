@model AccountSettingsViewModel
@{
    ViewData["Title"] = "Settings";
}

<h1 class="mb-4">Settings</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3">Notifications</h5>
                <p class="text-muted small">In-app notifications always continue &mdash; this only controls whether we also email you.</p>
                <form asp-action="Settings" method="post">
                    <div class="mb-3 form-check">
                        <input asp-for="EmailNotificationsEnabled" class="form-check-input" />
                        <label asp-for="EmailNotificationsEnabled" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>

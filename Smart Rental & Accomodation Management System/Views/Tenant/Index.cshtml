@model TenantDashboardViewModel
@{
    ViewData["Title"] = "Tenant Dashboard";
}

<h1 class="mb-4">My Dashboard</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (!Model.HasActiveLease)
{
    <div class="alert alert-info">
        You don't have an active lease yet. Once a landlord assigns you to a unit, your rent and payment details will show up here.
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-tile h-100">
                <div class="stat-tile-icon stat-tile-icon-primary"><i class="bi bi-door-open"></i></div>
                <div class="stat-tile-body">
                    <div class="stat-tile-label">My unit</div>
                    <div class="fs-5 fw-semibold">@Model.UnitName</div>
                    <div class="stat-tile-sub">@Model.PropertyName</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-tile h-100">
                <div class="stat-tile-icon stat-tile-icon-info"><i class="bi bi-cash"></i></div>
                <div class="stat-tile-body">
                    <div class="stat-tile-label">Monthly rent</div>
                    <div class="stat-tile-value">@Model.MonthlyRent.ToString("C")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-tile h-100">
                <div class="stat-tile-icon stat-tile-icon-success"><i class="bi bi-check-circle"></i></div>
                <div class="stat-tile-body">
                    <div class="stat-tile-label">Total paid</div>
                    <div class="stat-tile-value text-success">@Model.TotalPaid.ToString("C")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-tile h-100">
                <div class="stat-tile-icon @(Model.OutstandingBalance > 0 ? "stat-tile-icon-danger" : "stat-tile-icon-secondary")"><i class="bi bi-wallet2"></i></div>
                <div class="stat-tile-body">
                    <div class="stat-tile-label">Outstanding balance</div>
                    <div class="stat-tile-value @(Model.OutstandingBalance > 0 ? "text-danger" : "")">@Model.OutstandingBalance.ToString("C")</div>
                    @if (Model.OverdueInvoiceCount > 0)
                    {
                        <div class="stat-tile-sub text-danger">@Model.OverdueInvoiceCount overdue</div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.NextDueInvoice != null)
    {
        <div class="alert @(Model.NextDueInvoice.Status == InvoiceStatus.Overdue ? "alert-danger" : "alert-warning")">
            Next payment due: <strong>@Model.NextDueInvoice.Amount.ToString("C")</strong> by
            <strong>@Model.NextDueInvoice.DueDate.ToString("MMM d, yyyy")</strong>
            (@Model.NextDueInvoice.Status.Humanize())
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Payment history (last 6 months)</h5>
            <canvas id="paymentChart" height="90"></canvas>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">My invoices</h5>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Period</th>
                            <th>Amount</th>
                            <th>Due date</th>
                            <th>Status</th>
                            <th></th>
                            <th>Dispute</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in Model.Invoices)
                        {
                            <tr>
                                <td>@invoice.PeriodMonth/@invoice.PeriodYear</td>
                                <td>@invoice.Amount.ToString("C")</td>
                                <td>@invoice.DueDate.ToString("MMM d, yyyy")</td>
                                <td>
                                    @{
                                        var badgeClass = invoice.Status switch
                                        {
                                            InvoiceStatus.Paid => "text-bg-success",
                                            InvoiceStatus.Overdue => "text-bg-danger",
                                            _ => "text-bg-warning"
                                        };
                                    }
                                    <span class="badge @badgeClass">@invoice.Status.Humanize()</span>
                                    @if (invoice.Status != InvoiceStatus.Paid && invoice.TenantMarkedPaidAt != null)
                                    {
                                        <span class="badge text-bg-info">Awaiting confirmation</span>
                                    }
                                </td>
                                <td>
                                    @if (invoice.Status != InvoiceStatus.Paid && invoice.TenantMarkedPaidAt == null)
                                    {
                                        <form asp-action="MarkInvoicePaidByTenant" method="post" enctype="multipart/form-data" class="d-flex gap-1 align-items-center">
                                            <input type="hidden" name="invoiceId" value="@invoice.Id" />
                                            <input type="file" name="slip" class="form-control form-control-sm" accept="image/jpeg,image/png,application/pdf" style="width: 160px;" title="Payment slip (optional)" />
                                            <button type="submit" class="btn btn-sm btn-outline-success text-nowrap">I've paid</button>
                                        </form>
                                    }
                                </td>
                                <td>
                                    @if (invoice.DisputeStatus == DisputeStatus.None)
                                    {
                                        <form asp-action="RaiseInvoiceDispute" method="post" class="d-flex gap-1">
                                            <input type="hidden" name="invoiceId" value="@invoice.Id" />
                                            <input type="text" name="reason" class="form-control form-control-sm" placeholder="Reason" style="width: 140px;" required />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Dispute</button>
                                        </form>
                                    }
                                    else if (invoice.DisputeStatus == DisputeStatus.Open)
                                    {
                                        <span class="badge text-bg-warning">Dispute pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary" title="@invoice.DisputeResolution">Resolved</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Invoices.Any())
                        {
                            <tr><td colspan="6" class="text-muted">No invoices yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="card-title">My utility bills</h5>
                <div class="fw-semibold @(Model.UtilityOutstandingBalance > 0 ? "text-danger" : "text-success")">
                    Outstanding: @Model.UtilityOutstandingBalance.ToString("C")
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Property</th>
                            <th>Type</th>
                            <th>Your share</th>
                            <th>Due date</th>
                            <th>Status</th>
                            <th></th>
                            <th>Dispute</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var share in Model.UtilityShares)
                        {
                            <tr>
                                <td>@share.UtilityBill?.Property?.Name</td>
                                <td>@share.UtilityBill?.BillType.Humanize()</td>
                                <td>@share.ShareAmount.ToString("C")</td>
                                <td>@share.UtilityBill?.DueDate.ToString("MMM d, yyyy")</td>
                                <td>
                                    @if (share.IsPaid)
                                    {
                                        <span class="badge text-bg-success">Paid</span>
                                    }
                                    else if (share.UtilityBill != null && share.UtilityBill.DueDate < DateTime.UtcNow.Date)
                                    {
                                        <span class="badge text-bg-danger">Overdue</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-warning">Pending</span>
                                    }
                                    @if (!share.IsPaid && share.TenantMarkedPaidAt != null)
                                    {
                                        <span class="badge text-bg-info">Awaiting confirmation</span>
                                    }
                                </td>
                                <td>
                                    @if (!share.IsPaid && share.TenantMarkedPaidAt == null)
                                    {
                                        <form asp-action="MarkUtilitySharePaidByTenant" method="post" enctype="multipart/form-data" class="d-flex gap-1 align-items-center">
                                            <input type="hidden" name="shareId" value="@share.Id" />
                                            <input type="file" name="slip" class="form-control form-control-sm" accept="image/jpeg,image/png,application/pdf" style="width: 150px;" title="Payment slip (optional)" />
                                            <button type="submit" class="btn btn-sm btn-outline-success text-nowrap">I've paid</button>
                                        </form>
                                    }
                                </td>
                                <td>
                                    @if (share.DisputeStatus == DisputeStatus.None)
                                    {
                                        <form asp-controller="UtilityBill" asp-action="RaiseDispute" method="post" class="d-flex gap-1">
                                            <input type="hidden" name="shareId" value="@share.Id" />
                                            <input type="text" name="reason" class="form-control form-control-sm" placeholder="Reason" style="width: 140px;" required />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Dispute</button>
                                        </form>
                                    }
                                    else if (share.DisputeStatus == DisputeStatus.Open)
                                    {
                                        <span class="badge text-bg-warning">Dispute pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary" title="@share.DisputeResolution">Resolved</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.UtilityShares.Any())
                        {
                            <tr><td colspan="7" class="text-muted">No utility bills yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model.CanManageOccupants)
    {
        <div class="card mt-4">
            <div class="card-body">
                <h5 class="card-title">Occupants</h5>
                <div class="form-text mb-3">This unit is rented in your name as the head tenant. Add the people living with you here for the record.</div>

                @if (Model.Occupants.Any())
                {
                    <ul class="list-group mb-3">
                        @foreach (var occupant in Model.Occupants)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@occupant.Name @(string.IsNullOrEmpty(occupant.Phone) ? "" : $"({occupant.Phone})")</span>
                                <form asp-action="RemoveOccupant" method="post">
                                    <input type="hidden" name="occupantId" value="@occupant.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            data-confirm-title="Remove this occupant?"
                                            data-confirm-body="This just removes them from your unit's record.">Remove</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No occupants added yet.</p>
                }

                <form asp-action="AddOccupant" method="post" class="row g-2 align-items-end">
                    <input type="hidden" name="leaseId" value="@Model.LeaseId" />
                    <div class="col-sm-5">
                        <label class="form-label small mb-0">Name</label>
                        <input type="text" name="name" class="form-control form-control-sm" maxlength="100" required />
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label small mb-0">Phone (optional)</label>
                        <input type="text" name="phone" class="form-control form-control-sm" maxlength="30" />
                    </div>
                    <div class="col-sm-3">
                        <button type="submit" class="btn btn-sm btn-outline-primary w-100">Add Occupant</button>
                    </div>
                </form>
            </div>
        </div>
    }
}

@section Scripts {
    @if (Model.HasActiveLease)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
        <script>
            const ctx = document.getElementById('paymentChart');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.MonthlyPaymentHistory.Select(m => m.Label))),
                    datasets: [
                        {
                            label: 'Paid',
                            data: @Html.Raw(Json.Serialize(Model.MonthlyPaymentHistory.Select(m => m.Collected))),
                            backgroundColor: '#198754'
                        },
                        {
                            label: 'Outstanding',
                            data: @Html.Raw(Json.Serialize(Model.MonthlyPaymentHistory.Select(m => m.Outstanding))),
                            backgroundColor: '#dc3545'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    scales: { y: { beginAtZero: true } }
                }
            });
        </script>
    }
}

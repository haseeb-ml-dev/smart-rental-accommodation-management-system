@model List<BookingListItemViewModel>
@{
    ViewData["Title"] = "Booking Requests";
}

<h1 class="mb-4">Booking Requests</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Property</th>
                <th>Unit</th>
                <th>Tenant</th>
                <th>Requested dates</th>
                <th>Rent</th>
                <th>Requested on</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.PropertyName</td>
                    <td>@booking.UnitName</td>
                    <td>@booking.TenantName</td>
                    <td>
                        @booking.StartDate.ToString("MMM d, yyyy")
                        @if (booking.RequestedEndDate.HasValue)
                        {
                            <text> to @booking.RequestedEndDate.Value.ToString("MMM d, yyyy")</text>
                        }
                        else
                        {
                            <span class="text-muted small d-block">No end date given</span>
                        }
                    </td>
                    <td>
                        @booking.MonthlyRent.ToString("C") / mo
                        @if (booking.ProposedRent.HasValue)
                        {
                            <div class="small text-warning-emphasis">Tenant offered @booking.ProposedRent.Value.ToString("C") / mo</div>
                        }
                    </td>
                    <td>@booking.CreatedAt.ToString("MMM d, yyyy")</td>
                    <td class="d-flex gap-2">
                        <form asp-action="Approve" method="post">
                            <input type="hidden" name="bookingId" value="@booking.BookingId" />
                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                        </form>
                        <form asp-action="Reject" method="post">
                            <input type="hidden" name="bookingId" value="@booking.BookingId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-muted">No pending requests.</td></tr>
            }
        </tbody>
    </table>
</div>

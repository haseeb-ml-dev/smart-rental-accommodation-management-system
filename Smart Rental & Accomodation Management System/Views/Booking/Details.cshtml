@model UnitDetailViewModel
@{
    ViewData["Title"] = $"{Model.UnitName} · {Model.PropertyName}";
}

@if (Model.Latitude.HasValue && Model.Longitude.HasValue)
{
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@Model.UnitName <span class="text-muted fs-5">@Model.PropertyName</span></h1>
    <a asp-action="Browse" class="btn btn-outline-secondary">Back to Browse</a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<div class="row g-4">
    <div class="col-md-7">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Photos</h5>
                @if (Model.Images.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var image in Model.Images)
                        {
                            <img src="/uploads/units/@Model.UnitId/@image.FileName" style="width: 10rem; height: 8rem; object-fit: cover; cursor: pointer;" class="rounded photo-thumb" data-full-src="/uploads/units/@Model.UnitId/@image.FileName" alt="@Model.UnitName" />
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No images available.</p>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Location</h5>
                <p class="mb-2">@Model.Address</p>
                @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                {
                    <div id="unitMap" class="map-container mb-2" style="height: 260px;"></div>
                    <a href="https://www.google.com/maps?q=@(Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)),@(Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))" target="_blank" rel="noopener">Open in Google Maps</a>
                }
                else
                {
                    <span class="text-muted">Location not available yet.</span>
                }
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Details</h5>
                <dl class="row mb-0">
                    <dt class="col-6">Type</dt>
                    <dd class="col-6">
                        @Model.UnitType.Humanize()
                        @if (Model.BhkType != null)
                        {
                            <text> &middot; @Model.BhkType.Value.Humanize()</text>
                        }
                    </dd>
                    <dt class="col-6">Monthly rent</dt>
                    <dd class="col-6">@Model.MonthlyRent.ToString("C")</dd>
                    <dt class="col-6">Capacity</dt>
                    <dd class="col-6">@Model.Capacity</dd>
                    <dt class="col-6">Availability</dt>
                    <dd class="col-6">
                        @if (Model.IsAvailable)
                        {
                            <span class="badge text-bg-success">Available (@Model.ActiveLeaseCount/@Model.BookableSlots)</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Full (@Model.ActiveLeaseCount/@Model.BookableSlots)</span>
                        }
                    </dd>
                </dl>

                <hr />

                @if (Model.HasPendingRequestFromCurrentTenant)
                {
                    <div class="text-muted">You already have a pending request for this unit.</div>
                }
                else if (Model.IsAvailable)
                {
                    <form asp-action="RequestBooking" method="post">
                        <input type="hidden" name="unitId" value="@Model.UnitId" />
                        <div class="mb-2">
                            <label class="form-label">Move-in date</label>
                            <input type="date" id="startDate" name="startDate" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Move-out date (optional)</label>
                            <input type="date" id="endDate" name="endDate" class="form-control" />
                            <div class="form-text">Let the landlord know how long you want the unit for.</div>
                        </div>
                        <div id="estimatedTotalBox" class="alert alert-light border py-2 mb-2 d-none">
                            Estimated total: <strong id="estimatedTotalValue"></strong>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Propose a different monthly rent (optional)</label>
                            <input type="number" name="proposedRent" class="form-control" step="0.01" min="0" placeholder="e.g. @((Model.MonthlyRent * 0.9m).ToString("0"))" />
                            <div class="form-text">Listed rent is @Model.MonthlyRent.ToString("C") / month. If you offer a different amount, the landlord sees it as a starting point, and final terms are worked out with them directly.</div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Request to book</button>
                    </form>
                }
                else
                {
                    <div class="text-muted">This unit is currently full.</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="photoLightbox" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark">
            <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close" style="z-index: 1;"></button>
            <img id="photoLightboxImage" src="" class="w-100" style="max-height: 80vh; object-fit: contain;" alt="Unit photo" />
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var modalEl = document.getElementById('photoLightbox');
            var modalImage = document.getElementById('photoLightboxImage');
            if (!modalEl || !modalImage) return;

            var modal = new bootstrap.Modal(modalEl);
            document.querySelectorAll('.photo-thumb').forEach(function (thumb) {
                thumb.addEventListener('click', function () {
                    modalImage.src = thumb.getAttribute('data-full-src');
                    modal.show();
                });
            });
        })();
    </script>
    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
    {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script>
            (function () {
                var map = L.map('unitMap').setView([@Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture), @Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)], 15);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap contributors',
                    maxZoom: 19
                }).addTo(map);
                L.marker([@Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture), @Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)])
                    .addTo(map)
                    .bindPopup(@Html.Raw(Json.Serialize(Model.PropertyName)));
            })();
        </script>
    }
    <script>
        (function () {
            var monthlyRent = @Model.MonthlyRent.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var startInput = document.getElementById('startDate');
            var endInput = document.getElementById('endDate');
            var box = document.getElementById('estimatedTotalBox');
            var valueEl = document.getElementById('estimatedTotalValue');

            if (!startInput || !endInput) return;

            function update() {
                var start = new Date(startInput.value);
                var end = new Date(endInput.value);

                if (!endInput.value || isNaN(start) || isNaN(end) || end <= start) {
                    box.classList.add('d-none');
                    return;
                }

                var days = (end - start) / (1000 * 60 * 60 * 24);
                var months = Math.max(1, Math.ceil(days / 30.4375));
                var total = months * monthlyRent;

                valueEl.textContent = '$' + total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' (~' + months + ' month' + (months === 1 ? '' : 's') + ')';
                box.classList.remove('d-none');
            }

            startInput.addEventListener('change', update);
            endInput.addEventListener('change', update);
        })();
    </script>
}

@model TenantBrowseViewModel
@{
    ViewData["Title"] = "Browse & Book";
}

<h1 class="mb-4">Browse Units</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<form method="get" class="row g-2 mb-4 align-items-end">
    <div class="col-sm-3">
        <label class="form-label">City</label>
        <select name="City" class="form-select">
            <option value="">All cities</option>
            @foreach (var city in Model.Cities)
            {
                <option value="@city" selected="@(city == Model.Filter.City)">@city</option>
            }
        </select>
    </div>
    <div class="col-sm-2">
        <label class="form-label">Min rent</label>
        <input type="number" name="MinRent" class="form-control" min="0" step="1" value="@Model.Filter.MinRent" />
    </div>
    <div class="col-sm-2">
        <label class="form-label">Max rent</label>
        <input type="number" name="MaxRent" class="form-control" min="0" step="1" value="@Model.Filter.MaxRent" />
    </div>
    <div class="col-sm-3">
        <label class="form-label">Unit type</label>
        <select name="UnitType" class="form-select">
            <option value="">All types</option>
            @foreach (UnitType t in Enum.GetValues<UnitType>())
            {
                <option value="@t" selected="@(t == Model.Filter.UnitType)">@t.Humanize()</option>
            }
        </select>
    </div>
    <div class="col-sm-2">
        <button type="submit" class="btn btn-primary w-100">Search</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th></th>
                <th>Property</th>
                <th>Unit</th>
                <th>Type</th>
                <th>Monthly rent</th>
                <th>Availability</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var unit in Model.Units)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-unitId="@unit.UnitId">
                            @if (unit.CoverImageFileName != null)
                            {
                                <img src="/uploads/units/@unit.UnitId/@unit.CoverImageFileName" style="width: 3.5rem; height: 3.5rem; object-fit: cover;" class="rounded" alt="@unit.UnitName" />
                            }
                            else
                            {
                                <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted" style="width: 3.5rem; height: 3.5rem; font-size: 0.7rem;">No photo</div>
                            }
                        </a>
                    </td>
                    <td>
                        @unit.PropertyName
                        @if (unit.Latitude.HasValue && unit.Longitude.HasValue)
                        {
                            <a href="https://www.google.com/maps?q=@(unit.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)),@(unit.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))" target="_blank" rel="noopener" class="small ms-1">(map)</a>
                        }
                    </td>
                    <td><a asp-action="Details" asp-route-unitId="@unit.UnitId">@unit.UnitName</a></td>
                    <td>
                        @unit.UnitType.Humanize()
                        @if (unit.UnitType != UnitType.SharedRoom)
                        {
                            <span class="text-muted small">(sleeps @unit.Capacity)</span>
                        }
                    </td>
                    <td>@unit.MonthlyRent.ToString("C")</td>
                    <td>
                        @if (unit.IsAvailable)
                        {
                            <span class="badge text-bg-success">Available (@unit.ActiveLeaseCount/@unit.BookableSlots)</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Full (@unit.ActiveLeaseCount/@unit.BookableSlots)</span>
                        }
                    </td>
                    <td>
                        @if (unit.HasPendingRequestFromCurrentTenant)
                        {
                            <span class="text-muted small">Request pending</span>
                        }
                        else
                        {
                            <a asp-action="Details" asp-route-unitId="@unit.UnitId" class="btn btn-sm btn-primary">View / Book</a>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Units.Any())
            {
                <tr><td colspan="7" class="text-muted">No units match your search.</td></tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Filter.Page ? "active" : "")">
                    <a class="page-link"
                       asp-action="Browse"
                       asp-route-City="@Model.Filter.City"
                       asp-route-MinRent="@Model.Filter.MinRent"
                       asp-route-MaxRent="@Model.Filter.MaxRent"
                       asp-route-UnitType="@Model.Filter.UnitType"
                       asp-route-Page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}

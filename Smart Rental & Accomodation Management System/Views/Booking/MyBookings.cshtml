@model List<BookingListItemViewModel>
@{
    ViewData["Title"] = "My Bookings";
}

<h1 class="mb-4">My Bookings</h1>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Property</th>
                <th>Unit</th>
                <th>Requested start</th>
                <th>Status</th>
                <th>Requested on</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.PropertyName</td>
                    <td>@booking.UnitName</td>
                    <td>@booking.StartDate.ToString("MMM d, yyyy")</td>
                    <td>
                        @{
                            var badgeClass = booking.Status switch
                            {
                                BookingStatus.Approved => "text-bg-success",
                                BookingStatus.Rejected => "text-bg-danger",
                                BookingStatus.Cancelled => "text-bg-secondary",
                                _ => "text-bg-warning"
                            };
                        }
                        <span class="badge @badgeClass">@booking.Status.Humanize()</span>
                    </td>
                    <td>@booking.CreatedAt.ToString("MMM d, yyyy")</td>
                    <td>
                        @if (booking.Status == BookingStatus.Pending)
                        {
                            <form asp-action="CancelBooking" method="post" onsubmit="return confirm('Cancel this booking request?');">
                                <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-muted">You haven't requested any bookings yet.</td></tr>
            }
        </tbody>
    </table>
</div>

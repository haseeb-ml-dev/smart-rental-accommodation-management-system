@model List<BookingListItemViewModel>
@{
    ViewData["Title"] = "My Bookings";
}

<h1 class="mb-4">My Bookings</h1>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Property</th>
                <th>Unit</th>
                <th>Requested dates</th>
                <th>Rent</th>
                <th>Status</th>
                <th>Requested on</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.PropertyName</td>
                    <td>@booking.UnitName</td>
                    <td>
                        @booking.StartDate.ToString("MMM d, yyyy")
                        @if (booking.RequestedEndDate.HasValue)
                        {
                            <text> to @booking.RequestedEndDate.Value.ToString("MMM d, yyyy")</text>
                        }
                    </td>
                    <td>
                        @booking.MonthlyRent.ToString("C") / mo
                        @if (booking.ProposedRent.HasValue)
                        {
                            <div class="small text-warning-emphasis">You offered @booking.ProposedRent.Value.ToString("C") / mo</div>
                        }
                    </td>
                    <td>
                        @{
                            var badgeClass = booking.Status switch
                            {
                                BookingStatus.Approved => "text-bg-success",
                                BookingStatus.Rejected => "text-bg-danger",
                                BookingStatus.Cancelled => "text-bg-secondary",
                                _ => "text-bg-warning"
                            };
                        }
                        <span class="badge @badgeClass">@booking.Status.Humanize()</span>
                    </td>
                    <td>@booking.CreatedAt.ToString("MMM d, yyyy")</td>
                    <td>
                        @if (booking.Status == BookingStatus.Pending)
                        {
                            <form asp-action="CancelBooking" method="post">
                                <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        data-confirm-title="Cancel this booking request?"
                                        data-confirm-body="You can submit a new request again later if you change your mind.">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-muted">You haven't requested any bookings yet.</td></tr>
            }
        </tbody>
    </table>
</div>

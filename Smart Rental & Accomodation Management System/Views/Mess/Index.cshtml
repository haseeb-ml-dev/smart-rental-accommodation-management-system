@model MessTenantViewModel
@{
    ViewData["Title"] = "Mess Menu";
}

<h1 class="mb-4">Mess Menu</h1>

@if (!Model.HasProperty)
{
    <div class="alert alert-info">You don't have an active lease yet, so there's no mess menu to show.</div>
}
else
{
    <h5 class="text-muted mb-3">@Model.PropertyName</h5>

    <div class="table-responsive mb-4">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Day</th>
                    <th>Meal</th>
                    <th>Menu</th>
                    <th>Rating</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var slot in Model.Menu)
                {
                    <tr>
                        <td>@slot.DayOfWeek</td>
                        <td>@slot.MealType</td>
                        <td>@slot.Description</td>
                        <td>
                            @if (slot.AverageRating != null)
                            {
                                <span>&#9733; @slot.AverageRating.Value.ToString("0.0")</span>
                                <span class="text-muted small">(@slot.RatingCount)</span>
                            }
                            else
                            {
                                <span class="text-muted small">No ratings yet</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Menu.Any())
                {
                    <tr><td colspan="4" class="text-muted">The menu hasn't been set up yet.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Leave feedback</h5>
            <form asp-action="SubmitFeedback" method="post" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Day</label>
                    <select name="DayOfWeek" class="form-select">
                        @foreach (var day in Model.Menu.Select(m => m.DayOfWeek).Distinct())
                        {
                            <option value="@day">@day</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Meal</label>
                    <select name="MealType" class="form-select">
                        @foreach (MealType meal in Enum.GetValues(typeof(MealType)))
                        {
                            <option value="@meal">@meal</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Rating</label>
                    <select name="Rating" class="form-select">
                        <option value="5">5 (Excellent)</option>
                        <option value="4">4 (Good)</option>
                        <option value="3">3 (Okay)</option>
                        <option value="2">2 (Poor)</option>
                        <option value="1">1 (Bad)</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Comment (optional)</label>
                    <input type="text" name="Comment" class="form-control" />
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Recent feedback</h5>
            <table class="table table-sm mb-0">
                <thead>
                    <tr><th>Tenant</th><th>Day</th><th>Meal</th><th>Rating</th><th>Comment</th></tr>
                </thead>
                <tbody>
                    @foreach (var fb in Model.RecentFeedback)
                    {
                        <tr>
                            <td>@fb.Tenant?.FullName</td>
                            <td>@fb.DayOfWeek</td>
                            <td>@fb.MealType</td>
                            <td>&#9733; @fb.Rating</td>
                            <td>@fb.Comment</td>
                        </tr>
                    }
                    @if (!Model.RecentFeedback.Any())
                    {
                        <tr><td colspan="5" class="text-muted">No feedback yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

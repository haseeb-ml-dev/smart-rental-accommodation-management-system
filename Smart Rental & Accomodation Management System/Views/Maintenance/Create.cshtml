@model MaintenanceRequestFormViewModel
@{
    ViewData["Title"] = "Report an Issue";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="mb-4">Report an Issue</h1>
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="e.g. Leaking kitchen tap" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Details that will help the landlord fix this quickly"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="Category" class="form-label"></label>
                    <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<MaintenanceCategory>()"></select>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="Priority" class="form-label"></label>
                    <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<MaintenancePriority>()"></select>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Photo" class="form-label">Photo (optional)</label>
                <input asp-for="Photo" type="file" class="form-control" accept="image/jpeg,image/png,application/pdf" />
                <div class="form-text">JPG, PNG, or PDF up to 5 MB.</div>
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
            <a asp-action="MyRequests" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

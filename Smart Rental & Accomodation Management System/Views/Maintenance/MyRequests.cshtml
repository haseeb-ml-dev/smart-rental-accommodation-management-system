@model List<MaintenanceRequestListItemViewModel>
@{
    ViewData["Title"] = "My Maintenance Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My Maintenance Requests</h1>
    <a asp-action="Create" class="btn btn-primary">Report an Issue</a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">You haven't reported any issues yet.</div>
}

@foreach (var request in Model)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="card-title mb-1">@request.Title</h5>
                    <div class="text-muted small mb-2">
                        @request.PropertyName &middot; @request.UnitName &middot; @request.Category.Humanize() &middot; @request.Priority.Humanize() priority
                    </div>
                </div>
                @{
                    var badgeClass = request.Status switch
                    {
                        MaintenanceStatus.Resolved => "text-bg-success",
                        MaintenanceStatus.InProgress => "text-bg-warning",
                        _ => "text-bg-secondary"
                    };
                }
                <span class="badge @badgeClass">@request.Status.Humanize()</span>
            </div>
            <p class="mb-2">@request.Description</p>
            @if (request.PhotoFileName != null)
            {
                <img src="/uploads/payment-slips/maintenance/@request.Id/@request.PhotoFileName" style="width: 8rem; height: 6rem; object-fit: cover; cursor: pointer;" class="rounded photo-thumb mb-2" data-full-src="/uploads/payment-slips/maintenance/@request.Id/@request.PhotoFileName" alt="@request.Title" />
            }
            @if (!string.IsNullOrEmpty(request.LandlordNote))
            {
                <div class="alert alert-light border py-2 mb-0">
                    <strong>Landlord note:</strong> @request.LandlordNote
                </div>
            }
            <div class="text-muted small mt-2">
                Reported @request.CreatedAt.ToString("MMM d, yyyy")
                @if (request.ResolvedAt.HasValue)
                {
                    <text> &middot; Resolved @request.ResolvedAt.Value.ToString("MMM d, yyyy")</text>
                }
            </div>
        </div>
    </div>
}

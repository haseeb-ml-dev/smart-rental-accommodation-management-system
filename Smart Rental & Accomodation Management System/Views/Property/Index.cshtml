@model List<Property>
@{
    ViewData["Title"] = "My Properties";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My Properties</h1>
    <a asp-action="Create" class="btn btn-primary">Add Property</a>
</div>

@foreach (var property in Model)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="card-title mb-1">
                        @property.Name
                        @if (property.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Delisted</span>
                        }
                    </h5>
                    <div class="text-muted small mb-3">
                        @property.Address
                        @if (!string.IsNullOrEmpty(property.Area) || !string.IsNullOrEmpty(property.City))
                        {
                            <text> &middot; @string.Join(", ", new[] { property.Area, property.City }.Where(s => !string.IsNullOrEmpty(s)))</text>
                        }
                        @if (property.Latitude.HasValue && property.Longitude.HasValue)
                        {
                            <a href="https://www.google.com/maps?q=@(property.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)),@(property.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))" target="_blank" rel="noopener" class="ms-1">View on map</a>
                        }
                        else
                        {
                            <span class="ms-1">(not mapped yet)</span>
                        }
                    </div>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-action="EditProperty" asp-route-id="@property.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="AddUnit" asp-route-propertyId="@property.Id" class="btn btn-sm btn-outline-primary">Add Unit</a>
                    <a asp-controller="UtilityBill" asp-action="Create" asp-route-propertyId="@property.Id" class="btn btn-sm btn-outline-secondary">Add Utility Bill</a>
                    <a asp-controller="Mess" asp-action="Manage" asp-route-propertyId="@property.Id" class="btn btn-sm btn-outline-secondary">Mess Menu</a>
                    <a asp-controller="Mess" asp-action="Feedback" asp-route-propertyId="@property.Id" class="btn btn-sm btn-outline-secondary">Mess Feedback</a>
                    <a asp-controller="Booking" asp-action="Calendar" asp-route-propertyId="@property.Id" class="btn btn-sm btn-outline-secondary">Booking Calendar</a>
                    <form asp-action="ToggleActive" method="post" onsubmit="return confirm('@(property.IsActive ? "Delist this property? It will disappear from Browse until relisted." : "Relist this property?")');">
                        <input type="hidden" name="propertyId" value="@property.Id" />
                        @if (property.IsActive)
                        {
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delist</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-outline-success">Relist</button>
                        }
                    </form>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Unit</th>
                            <th>Type</th>
                            <th>BHK</th>
                            <th>Monthly rent</th>
                            <th>Capacity</th>
                            <th>Meters</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var unit in property.Units)
                        {
                            var cover = unit.Images.FirstOrDefault(i => i.IsCover) ?? unit.Images.FirstOrDefault();
                            <tr>
                                <td>
                                    @if (cover != null)
                                    {
                                        <img src="/uploads/units/@unit.Id/@cover.FileName" style="width: 3.5rem; height: 3.5rem; object-fit: cover;" class="rounded" alt="@unit.Name" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted" style="width: 3.5rem; height: 3.5rem; font-size: 0.7rem;">No photo</div>
                                    }
                                </td>
                                <td>@unit.Name</td>
                                <td>@unit.UnitType.Humanize()</td>
                                <td>@(unit.BhkType?.Humanize() ?? "Not set")</td>
                                <td>@unit.MonthlyRent.ToString("C")</td>
                                <td>@unit.Capacity</td>
                                <td>
                                    @if (unit.HasIndividualElectricityMeter)
                                    {
                                        <span class="badge text-bg-light border me-1">⚡ own meter</span>
                                    }
                                    @if (unit.HasIndividualWaterMeter)
                                    {
                                        <span class="badge text-bg-light border">💧 own meter</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="ManageTenants" asp-route-unitId="@unit.Id" class="btn btn-sm btn-outline-primary">Tenants</a>
                                    <a asp-action="EditUnit" asp-route-id="@unit.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                </td>
                            </tr>
                        }
                        @if (!property.Units.Any())
                        {
                            <tr><td colspan="8" class="text-muted">No units yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">You haven't added any properties yet.</div>
}

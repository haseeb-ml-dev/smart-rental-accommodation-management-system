@model UnitTenantsViewModel
@{
    ViewData["Title"] = "Manage Tenants";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">@Model.UnitName</h1>
        <div class="text-muted">@Model.PropertyName &middot; @Model.ActiveLeaseCount/@Model.BookableSlots slots filled</div>
    </div>
    <a asp-action="Index" class="btn btn-link">Back to Properties</a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Active tenants</h5>
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr><th>Tenant</th><th>Lease start</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var lease in Model.ActiveLeases)
                {
                    <tr>
                        <td>@lease.TenantName</td>
                        <td>@lease.StartDate.ToString("MMM d, yyyy")</td>
                        <td>
                            <form asp-action="EndLease" method="post" class="d-inline">
                                <input type="hidden" name="leaseId" value="@lease.LeaseId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">End lease</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.ActiveLeases.Any())
                {
                    <tr><td colspan="3" class="text-muted">No active tenants on this unit.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Assign a tenant</h5>
        @if (!Model.HasFreeSlot)
        {
            <div class="alert alert-warning mb-0">This unit is full. End a lease to free up a slot before assigning another tenant.</div>
        }
        else if (!Model.AvailableTenants.Any())
        {
            <div class="alert alert-info mb-0">No tenant accounts available to assign (they may all already have an active lease here).</div>
        }
        else
        {
            <form asp-action="AssignTenant" method="post" class="row g-2 align-items-end">
                <input type="hidden" name="unitId" value="@Model.UnitId" />
                <div class="col-md-6">
                    <label class="form-label">Tenant</label>
                    <select name="tenantId" class="form-select">
                        @foreach (var tenant in Model.AvailableTenants)
                        {
                            <option value="@tenant.Id">@tenant.Label</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Lease start date</label>
                    <input type="date" name="startDate" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary">Assign</button>
                </div>
            </form>
        }
    </div>
</div>

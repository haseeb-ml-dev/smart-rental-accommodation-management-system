@model PropertyFormViewModel
@{
    ViewData["Title"] = "Add Property";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="mb-4">Add Property</h1>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="City" class="form-label"></label>
                @{
                    var cities = (List<string>)ViewBag.Cities;
                }
                @if (cities.Any())
                {
                    <select asp-for="City" class="form-select">
                        <option value="">— Select a city —</option>
                        @foreach (var city in cities)
                        {
                            <option value="@city">@city</option>
                        }
                    </select>
                }
                else
                {
                    <input asp-for="City" class="form-control" placeholder="Optional" />
                }
                <span asp-validation-for="City" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

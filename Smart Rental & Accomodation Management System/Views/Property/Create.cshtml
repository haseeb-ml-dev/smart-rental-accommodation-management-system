@model PropertyFormViewModel
@{
    ViewData["Title"] = "Add Property";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="mb-4">Add Property</h1>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control"
                       data-autocomplete="address"
                       data-lat-input="#propLat"
                       data-lng-input="#propLng"
                       data-confirmed-input="#propLocationConfirmed"
                       data-map-target="propertyMap"
                       data-map-card="#locationCard"
                       placeholder="Start typing an address" />
                <div class="form-text">Pick a suggestion for the most accurate map placement, or type your own. You can fine-tune the exact spot by dragging the pin once it appears.</div>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <input type="hidden" id="propLat" name="Latitude" value="@Model.Latitude" />
            <input type="hidden" id="propLng" name="Longitude" value="@Model.Longitude" />
            <input type="hidden" id="propLocationConfirmed" name="LocationConfirmed" value="@Model.LocationConfirmed.ToString().ToLowerInvariant()" />
            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="City" class="form-label"></label>
                    @{
                        var cities = (List<string>)ViewBag.Cities;
                    }
                    @if (cities.Any())
                    {
                        <select asp-for="City" id="propCity" class="form-select">
                            <option value="">Select a city</option>
                            @foreach (var city in cities)
                            {
                                <option value="@city">@city</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input asp-for="City" class="form-control" placeholder="Optional" />
                    }
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="Area" class="form-label"></label>
                    @if (cities.Any())
                    {
                        <select asp-for="Area" id="propArea" class="form-select"
                                data-cascade-source="#propCity"
                                data-cascade-options="@System.Text.Json.JsonSerializer.Serialize(ViewBag.AreasByCity)"
                                data-cascade-placeholder="Select an area"
                                data-cascade-initial="@Model.Area">
                            <option value="">Select a city first</option>
                        </select>
                    }
                    else
                    {
                        <input asp-for="Area" class="form-control" placeholder="Optional" />
                    }
                    <span asp-validation-for="Area" class="text-danger"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>

        <div class="card mt-4 d-none" id="locationCard">
            <div class="card-body">
                <h5 class="card-title">Location on map</h5>
                <p class="text-muted small">Drag the pin to correct the exact spot if the address placed it slightly off.</p>
                <div id="propertyMap" class="map-container" style="height: 260px;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
}

@model UnitFormViewModel
@{
    ViewData["Title"] = "Edit Unit";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="mb-4">Edit Unit &mdash; @Model.PropertyName</h1>
        <form asp-action="EditUnit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PropertyId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Room A1" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UnitType" class="form-label"></label>
                <select asp-for="UnitType" id="UnitType" class="form-select" asp-items="Html.GetEnumSelectList<UnitType>()"></select>
                <span asp-validation-for="UnitType" class="text-danger"></span>
            </div>
            <div class="mb-3" id="bhkGroup">
                <label asp-for="BhkType" class="form-label"></label>
                <select asp-for="BhkType" class="form-select" asp-items="Html.GetEnumSelectList<BhkType>()">
                    <option value="">N/A</option>
                </select>
                <div class="form-text">Only needed for Family Unit / apartment listings.</div>
                <span asp-validation-for="BhkType" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MonthlyRent" class="form-label"></label>
                <input asp-for="MonthlyRent" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="MonthlyRent" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Capacity" class="form-label"></label>
                <input asp-for="Capacity" class="form-control" type="number" />
                <div class="form-text">
                    Shared Room: number of seats — each tenant books their own seat, up to this many at once.<br />
                    Private Room / Family Unit: occupancy estimate only (e.g. "sleeps 6") — the unit is leased to a single tenant/family at a time, regardless of this number.
                </div>
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="HasIndividualElectricityMeter" class="form-check-input" />
                <label asp-for="HasIndividualElectricityMeter" class="form-check-label"></label>
                <div class="form-text">If checked, this unit's tenant is billed separately and excluded from the property's shared electricity bill split.</div>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="HasIndividualWaterMeter" class="form-check-input" />
                <label asp-for="HasIndividualWaterMeter" class="form-check-label"></label>
                <div class="form-text">If checked, this unit's tenant is billed separately and excluded from the property's shared water bill split.</div>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>

        <hr class="my-4" />

        <h2 class="h5 mb-3">Photos</h2>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-info">@TempData["Message"]</div>
        }

        @{
            var images = (List<UnitImage>)ViewBag.UnitImages;
            var maxImages = (int)ViewBag.MaxImagesPerUnit;
        }

        @if (images.Any())
        {
            <div class="d-flex flex-wrap gap-3 mb-3">
                @foreach (var image in images)
                {
                    <div class="card" style="width: 10rem;">
                        <img src="/uploads/units/@Model.Id/@image.FileName" class="card-img-top" style="height: 8rem; object-fit: cover;" alt="Unit photo" />
                        <div class="card-body p-2 text-center">
                            @if (image.IsCover)
                            {
                                <span class="badge text-bg-primary d-block mb-2">Cover</span>
                            }
                            else
                            {
                                <form asp-action="SetCoverImage" method="post" class="mb-2">
                                    <input type="hidden" name="imageId" value="@image.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Set as cover</button>
                                </form>
                            }
                            <form asp-action="DeleteImage" method="post" onsubmit="return confirm('Delete this photo?');">
                                <input type="hidden" name="imageId" value="@image.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100">Delete</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">No photos yet.</p>
        }

        @if (images.Count < maxImages)
        {
            <form asp-action="UploadImages" method="post" enctype="multipart/form-data" class="d-flex gap-2 align-items-center">
                <input type="hidden" name="unitId" value="@Model.Id" />
                <input type="file" name="files" class="form-control" accept="image/jpeg,image/png,image/webp" multiple />
                <button type="submit" class="btn btn-outline-primary text-nowrap">Upload</button>
            </form>
            <div class="form-text">JPG, PNG, or WEBP, up to 5 MB each. Up to @maxImages photos per unit.</div>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            var unitTypeSelect = document.getElementById('UnitType');
            var bhkGroup = document.getElementById('bhkGroup');
            var familyUnitValue = '@((int)UnitType.FamilyUnit)';

            function toggleBhk() {
                bhkGroup.style.display = unitTypeSelect.value === familyUnitValue ? '' : 'none';
            }

            unitTypeSelect.addEventListener('change', toggleBhk);
            toggleBhk();
        })();
    </script>
}

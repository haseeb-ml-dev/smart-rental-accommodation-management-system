@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Admin Dashboard</h1>
    <div class="d-flex gap-2">
        <a asp-action="Users" class="btn btn-outline-primary">Users</a>
        <a asp-action="Bookings" class="btn btn-outline-primary">Bookings</a>
        <a asp-action="MessRatings" class="btn btn-outline-primary">Mess Ratings</a>
        <a asp-action="Settings" class="btn btn-outline-primary">Settings</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Landlords</div>
                <div class="fs-3 fw-semibold">@Model.TotalLandlords</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Tenants</div>
                <div class="fs-3 fw-semibold">@Model.TotalTenants</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Properties / Units</div>
                <div class="fs-3 fw-semibold">@Model.TotalProperties / @Model.TotalUnits</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Overdue invoices</div>
                <div class="fs-3 fw-semibold @(Model.OverdueInvoiceCount > 0 ? "text-danger" : "")">@Model.OverdueInvoiceCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Top-rated mess</div>
                @if (Model.TopRatedPropertyName != null)
                {
                    <div class="fs-3 fw-semibold">@Model.TopRatedPropertyAverage!.Value.ToString("0.0") <span class="fs-6 text-muted">/ 5</span></div>
                    <div class="text-muted small text-truncate">@Model.TopRatedPropertyName</div>
                }
                else
                {
                    <div class="text-muted small">Not enough ratings yet</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Collected this month (system-wide)</div>
                <div class="fs-3 fw-semibold text-success">@Model.CollectedThisMonth.ToString("C")</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Outstanding this month (system-wide)</div>
                <div class="fs-3 fw-semibold text-danger">@Model.OutstandingThisMonth.ToString("C")</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Collection history (last 6 months)</h5>
        <canvas id="collectionChart" height="90"></canvas>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Properties</h5>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Landlord</th>
                                <th>Units</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var property in Model.Properties)
                            {
                                <tr>
                                    <td>@property.Name</td>
                                    <td>@property.Landlord?.FullName</td>
                                    <td>@property.Units.Count</td>
                                    <td>
                                        @if (property.IsActive)
                                        {
                                            <span class="badge text-bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">Delisted</span>
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="TogglePropertyActive" method="post">
                                            <input type="hidden" name="propertyId" value="@property.Id" />
                                            @if (property.IsActive)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">Delist</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success">Relist</button>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Properties.Any())
                            {
                                <tr><td colspan="5" class="text-muted">No properties yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Recent invoices</h5>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Tenant</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var invoice in Model.RecentInvoices)
                            {
                                <tr>
                                    <td>@invoice.Lease?.Tenant?.FullName</td>
                                    <td>@invoice.Amount.ToString("C")</td>
                                    <td>
                                        @{
                                            var badgeClass = invoice.Status switch
                                            {
                                                InvoiceStatus.Paid => "text-bg-success",
                                                InvoiceStatus.Overdue => "text-bg-danger",
                                                _ => "text-bg-warning"
                                            };
                                        }
                                        <span class="badge @badgeClass">@invoice.Status.Humanize()</span>
                                    </td>
                                </tr>
                            }
                            @if (!Model.RecentInvoices.Any())
                            {
                                <tr><td colspan="3" class="text-muted">No invoices yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script>
        const ctx = document.getElementById('collectionChart');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.MonthlyCollection.Select(m => m.Label))),
                datasets: [
                    {
                        label: 'Collected',
                        data: @Html.Raw(Json.Serialize(Model.MonthlyCollection.Select(m => m.Collected))),
                        backgroundColor: '#198754'
                    },
                    {
                        label: 'Outstanding',
                        data: @Html.Raw(Json.Serialize(Model.MonthlyCollection.Select(m => m.Outstanding))),
                        backgroundColor: '#dc3545'
                    }
                ]
            },
            options: {
                responsive: true,
                scales: { y: { beginAtZero: true } }
            }
        });
    </script>
}

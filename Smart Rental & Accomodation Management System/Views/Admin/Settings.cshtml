@model SettingsFormViewModel
@{
    ViewData["Title"] = "Settings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Settings</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<div class="row g-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3">Billing defaults</h5>
                <form asp-action="Settings" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="DefaultUtilitySplitMethod" class="form-label"></label>
                        <select asp-for="DefaultUtilitySplitMethod" class="form-select" asp-items="Html.GetEnumSelectList<UtilityBillSplitMethod>()"></select>
                        <div class="form-text">Pre-selected split method when a landlord creates a new utility bill.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="RentReminderDaysBefore" class="form-label"></label>
                        <input asp-for="RentReminderDaysBefore" class="form-control" type="number" />
                        <span asp-validation-for="RentReminderDaysBefore" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="UtilityReminderDaysBefore" class="form-label"></label>
                        <input asp-for="UtilityReminderDaysBefore" class="form-control" type="number" />
                        <span asp-validation-for="UtilityReminderDaysBefore" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="MonthlySubscriptionFee" class="form-label"></label>
                        <input asp-for="MonthlySubscriptionFee" class="form-control" type="number" step="0.01" />
                        <div class="form-text">Shown on the public Pricing page as the landlord subscription fee.</div>
                        <span asp-validation-for="MonthlySubscriptionFee" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3">Supported cities</h5>
                <div class="form-text mb-3">Cities landlords can pick from when adding a property. Leave empty to allow any address with no city dropdown.</div>

                <form asp-action="AddCity" method="post" class="d-flex gap-2 mb-3">
                    <input type="text" name="name" class="form-control" placeholder="e.g. Lahore" maxlength="100" required />
                    <button type="submit" class="btn btn-outline-primary text-nowrap">Add City</button>
                </form>

                @if (Model.Cities.Any())
                {
                    <ul class="list-group">
                        @foreach (var city in Model.Cities)
                        {
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-semibold">@city.Name</span>
                                    <form asp-action="DeleteCity" method="post">
                                        <input type="hidden" name="cityId" value="@city.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                data-confirm-title="Remove this city?"
                                                data-confirm-body="Its areas will be removed too. Landlords will no longer be able to pick it for new properties.">Remove city</button>
                                    </form>
                                </div>

                                <div class="ms-3 mt-2">
                                    @if (city.Areas.Any())
                                    {
                                        <ul class="list-unstyled mb-2">
                                            @foreach (var area in city.Areas)
                                            {
                                                <li class="d-flex justify-content-between align-items-center py-1">
                                                    <span class="text-muted small">@area.Name</span>
                                                    <form asp-action="DeleteArea" method="post">
                                                        <input type="hidden" name="areaId" value="@area.Id" />
                                                        <button type="submit" class="btn btn-sm btn-link text-danger p-0"
                                                                data-confirm-title="Remove this area?"
                                                                data-confirm-body="Landlords will no longer be able to pick it for new properties.">Remove</button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p class="text-muted small mb-2">No areas configured for this city yet.</p>
                                    }

                                    <form asp-action="AddArea" method="post" class="d-flex gap-2">
                                        <input type="hidden" name="cityId" value="@city.Id" />
                                        <input type="text" name="name" class="form-control form-control-sm" placeholder="e.g. Downtown" maxlength="100" required />
                                        <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Add Area</button>
                                    </form>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No cities configured yet.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model List<BlogPost>
@{
    ViewData["Title"] = "Blog";
}

<h1 class="mb-2">The RehLe Blog</h1>
<p class="text-muted mb-4">Practical guidance for landlords and tenants renting in Pakistan.</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No articles published yet — check back soon.</div>
}

<div class="row g-4">
    @foreach (var post in Model)
    {
        <div class="col-md-6 col-lg-4">
            <a asp-action="Details" asp-route-slug="@post.Slug" class="text-decoration-none text-body">
                <div class="card h-100">
                    <div class="blog-card-header"><i class="bi bi-journal-text"></i></div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-2">@post.Title</h5>
                        <p class="text-muted small flex-grow-1">@post.Excerpt</p>
                        <div class="text-muted small">@post.PublishedAt?.ToString("MMM d, yyyy")</div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

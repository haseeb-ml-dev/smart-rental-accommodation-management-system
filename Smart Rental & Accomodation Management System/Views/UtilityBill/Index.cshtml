@model List<UtilityBill>
@{
    ViewData["Title"] = "Utility Bills";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Utility Bills</h1>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@foreach (var bill in Model)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between">
                <h5 class="card-title">@bill.Property?.Name &middot; @bill.BillType.Humanize() (@bill.PeriodMonth/@bill.PeriodYear)</h5>
                <div class="fw-semibold">@bill.Amount.ToString("C")</div>
            </div>
            <div class="text-muted small mb-2">
                Due @bill.DueDate.ToString("MMM d, yyyy") &middot; Split: @bill.SplitMethod.Humanize()
                @if (bill.SplitMethod == UtilityBillSplitMethod.PerUnitConsumption && bill.TotalUnitsConsumed is > 0)
                {
                    <text>&middot; @bill.TotalUnitsConsumed units total &middot; @((bill.Amount / bill.TotalUnitsConsumed.Value).ToString("C")) / unit</text>
                }
            </div>
            <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr><th>Tenant</th><th>Share</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var share in bill.Shares)
                    {
                        <tr>
                            <td>@share.Tenant?.FullName</td>
                            <td>
                                @share.ShareAmount.ToString("C")
                                @(share.Percentage != null ? $" ({share.Percentage}%)" : "")
                                @(share.UnitsConsumed != null ? $" ({share.UnitsConsumed} units)" : "")
                            </td>
                            <td>
                                @if (share.IsPaid)
                                {
                                    <span class="badge text-bg-success">Paid</span>
                                }
                                else if (bill.DueDate < DateTime.UtcNow.Date)
                                {
                                    <span class="badge text-bg-danger">Overdue</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning">Pending</span>
                                }
                                @if (share.DisputeStatus == DisputeStatus.Open)
                                {
                                    <span class="badge text-bg-danger">Disputed</span>
                                }
                                else if (share.DisputeStatus == DisputeStatus.Resolved)
                                {
                                    <span class="badge text-bg-secondary">Dispute resolved</span>
                                }
                            </td>
                            <td>
                                @if (!share.IsPaid)
                                {
                                    @if (share.TenantMarkedPaidAt != null)
                                    {
                                        <div class="small text-info mb-1">
                                            Tenant marked paid
                                            @if (share.PaymentSlipFileName != null)
                                            {
                                                <a href="/uploads/payment-slips/utility/@share.Id/@share.PaymentSlipFileName" target="_blank" rel="noopener">(view slip)</a>
                                            }
                                        </div>
                                    }
                                    @if (share.DisputeStatus != DisputeStatus.Open)
                                    {
                                        <div class="d-flex gap-1">
                                            <form asp-action="MarkSharePaid" method="post" class="d-inline">
                                                <input type="hidden" name="shareId" value="@share.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-success"
                                                        data-confirm-title="Confirm this payment was received?"
                                                        data-confirm-body="This marks the share paid and notifies the tenant.">Confirm received</button>
                                            </form>
                                            @if (share.TenantMarkedPaidAt != null)
                                            {
                                                <form asp-action="RejectSharePayment" method="post" class="d-inline">
                                                    <input type="hidden" name="shareId" value="@share.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                                            data-confirm-title="Mark this payment as not received?"
                                                            data-confirm-body="This opens a dispute and notifies the tenant.">Not received</button>
                                                </form>
                                            }
                                        </div>
                                    }
                                }
                            </td>
                        </tr>
                        @if (share.DisputeStatus == DisputeStatus.Open)
                        {
                            <tr>
                                <td colspan="4">
                                    <div class="alert alert-warning py-2 mb-0">
                                        <div class="small mb-2"><strong>Dispute reason:</strong> @share.DisputeReason</div>
                                        <form asp-action="ResolveDispute" method="post" class="row g-2 align-items-end">
                                            <input type="hidden" name="shareId" value="@share.Id" />
                                            <div class="col-md-6">
                                                <label class="form-label small mb-0">Resolution note</label>
                                                <input type="text" name="resolution" class="form-control form-control-sm" required />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small mb-0">Adjusted amount (optional)</label>
                                                <input type="number" step="0.01" name="adjustedAmount" class="form-control form-control-sm" />
                                            </div>
                                            <div class="col-md-3">
                                                <button type="submit" class="btn btn-sm btn-primary w-100"
                                                        data-confirm-title="Resolve this dispute?"
                                                        data-confirm-body="This marks the dispute resolved and notifies the tenant.">Resolve dispute</button>
                                            </div>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            </div>
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No utility bills yet. Add one from your <a asp-controller="Property" asp-action="Index">Properties</a> page.</div>
}

@model List<UtilityBill>
@{
    ViewData["Title"] = "Utility Bills";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Utility Bills</h1>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@foreach (var bill in Model)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between">
                <h5 class="card-title">@bill.Property?.Name &mdash; @bill.BillType.Humanize() (@bill.PeriodMonth/@bill.PeriodYear)</h5>
                <div class="fw-semibold">@bill.Amount.ToString("C")</div>
            </div>
            <div class="text-muted small mb-2">Due @bill.DueDate.ToString("MMM d, yyyy") &middot; Split: @bill.SplitMethod.Humanize()</div>
            <table class="table table-sm mb-0">
                <thead>
                    <tr><th>Tenant</th><th>Share</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var share in bill.Shares)
                    {
                        <tr>
                            <td>@share.Tenant?.FullName</td>
                            <td>@share.ShareAmount.ToString("C")@(share.Percentage != null ? $" ({share.Percentage}%)" : "")</td>
                            <td>
                                @if (share.IsPaid)
                                {
                                    <span class="badge text-bg-success">Paid</span>
                                }
                                else if (bill.DueDate < DateTime.UtcNow.Date)
                                {
                                    <span class="badge text-bg-danger">Overdue</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning">Pending</span>
                                }
                            </td>
                            <td>
                                @if (!share.IsPaid)
                                {
                                    <form asp-action="MarkSharePaid" method="post">
                                        <input type="hidden" name="shareId" value="@share.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">Mark paid</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No utility bills yet. Add one from your <a asp-controller="Property" asp-action="Index">Properties</a> page.</div>
}

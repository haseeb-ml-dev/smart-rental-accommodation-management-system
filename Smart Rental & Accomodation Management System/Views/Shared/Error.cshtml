@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="row justify-content-center">
    <div class="col-md-7 text-center py-5">
        <div class="error-icon mx-auto">
            <i class="bi bi-exclamation-triangle"></i>
        </div>
        <h1 class="h3 mb-2">Something went wrong</h1>
        <p class="text-muted mb-4">
            We hit an unexpected error processing your request. It's been logged; try again, and if it keeps
            happening, let us know what you were doing.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted small mb-4">Reference ID: <code>@Model.RequestId</code></p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a>
    </div>
</div>

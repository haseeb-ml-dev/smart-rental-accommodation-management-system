@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Smart_Rental___Accomodation_Management_System.Data
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &middot; Smart Rental &amp; Accommodation</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Smart_Rental___Accomodation_Management_System.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom mb-3">
            <div class="container-fluid">
                <a class="navbar-brand brand-mark" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 10.5 12 3l9 7.5" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M5 9.5V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.5" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Smart Rental
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @{
                        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                        Func<string, string> navClass = c => "nav-link text-dark" + (string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase) ? " active" : "");
                    }
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity == null || !User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="@navClass("Home")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                        }
                        @if (User.IsInRole("Landlord"))
                        {
                            <li class="nav-item">
                                <a class="@navClass("Landlord")" asp-area="" asp-controller="Landlord" asp-action="Index">Dashboard</a>
                            </li>
                        }
                        else if (User.IsInRole("Tenant"))
                        {
                            <li class="nav-item">
                                <a class="@navClass("Tenant")" asp-area="" asp-controller="Tenant" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="@navClass("Booking")" asp-area="" asp-controller="Booking" asp-action="Browse">Browse &amp; Book</a>
                            </li>
                            <li class="nav-item">
                                <a class="@navClass("Booking")" asp-area="" asp-controller="Booking" asp-action="MyBookings">My Bookings</a>
                            </li>
                            <li class="nav-item">
                                <a class="@navClass("Mess")" asp-area="" asp-controller="Mess" asp-action="Index">Mess Menu</a>
                            </li>
                        }
                        else if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="@navClass("Admin")" asp-area="" asp-controller="Admin" asp-action="Index">Dashboard</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-sm-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var currentUserId = UserManager.GetUserId(User);
                            var unreadCount = await DbContext.Notifications.CountAsync(n => n.RecipientId == currentUserId && !n.IsRead);
                            var currentUser = await UserManager.FindByIdAsync(currentUserId!);
                            var displayName = string.IsNullOrWhiteSpace(currentUser?.FullName) ? User.Identity.Name : currentUser.FullName;
                            <li class="nav-item">
                                <a class="@navClass("Notification")" asp-area="" asp-controller="Notification" asp-action="Index">
                                    🔔 Notifications
                                    @if (unreadCount > 0)
                                    {
                                        <span class="badge text-bg-danger rounded-pill">@unreadCount</span>
                                    }
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @displayName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Profile</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item ms-sm-2">
                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container page-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year Smart Rental &amp; Accommodation &middot; <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/address-autocomplete.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

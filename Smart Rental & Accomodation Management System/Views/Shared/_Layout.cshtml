@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Smart_Rental___Accomodation_Management_System.Data
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &middot; RehLe</title>
    <script type="importmap"></script>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="manifest" href="~/site.webmanifest" asp-append-version="true" />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Smart_Rental___Accomodation_Management_System.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-toggleable-sm navbar-light bg-white border-bottom mb-3 sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand brand-mark" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="1" y="1" width="22" height="22" rx="6" fill="var(--brand)" />
                        <path d="M12 5 18 10.2V18H6v-7.8Z" fill="#ffffff" />
                        <rect x="10" y="13" width="4" height="5" rx="1" fill="var(--brand)" />
                    </svg>
                    RehLe
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    @{
                        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                        Func<string, string, string> navClass = (c, a) => "nav-link text-dark" +
                            (string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, a, StringComparison.OrdinalIgnoreCase) ? " active" : "");
                    }
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity == null || !User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="@navClass("Home", "Index")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="@navClass("Home", "Listings")" asp-area="" asp-controller="Home" asp-action="Listings">Listings</a>
                            </li>
                            <li class="nav-item">
                                <a class="@navClass("Home", "Pricing")" asp-area="" asp-controller="Home" asp-action="Pricing">Pricing</a>
                            </li>
                        }
                        @{
                            var showLandlordFeatures = !User.IsInRole("Tenant");
                            var showTenantFeatures = !User.IsInRole("Landlord");
                            var featureColClass = showLandlordFeatures && showTenantFeatures ? "col-6" : "col-12";
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Features
                            </a>
                            <div class="dropdown-menu mega-dropdown">
                                <div class="row g-3">
                                    @if (showLandlordFeatures)
                                    {
                                        <div class="@featureColClass">
                                            <div class="mega-dropdown-group">
                                                <a class="dropdown-item mega-dropdown-heading text-decoration-none" asp-controller="Resources" asp-action="Details" asp-route-slug="for-landlords">For Landlords</a>
                                                <a class="dropdown-item" asp-controller="Resources" asp-action="Details" asp-route-slug="property-listings">Property Listings</a>
                                                <a class="dropdown-item" asp-controller="Resources" asp-action="Details" asp-route-slug="rent-collection">Rent Collection</a>
                                                <a class="dropdown-item" asp-controller="Resources" asp-action="Details" asp-route-slug="utility-bill-splitting">Utility Bill Splitting</a>
                                                <a class="dropdown-item" asp-controller="Resources" asp-action="Details" asp-route-slug="maintenance-tracking">Maintenance Tracking</a>
                                            </div>
                                        </div>
                                    }
                                    @if (showTenantFeatures)
                                    {
                                        <div class="@featureColClass">
                                            <div class="mega-dropdown-group">
                                                <a class="dropdown-item mega-dropdown-heading text-decoration-none" asp-controller="Resources" asp-action="Details" asp-route-slug="for-tenants">For Tenants</a>
                                                <a class="dropdown-item" asp-controller="Resources" asp-action="Details" asp-route-slug="search-and-booking">Search &amp; Booking</a>
                                                <a class="dropdown-item" asp-controller="Resources" asp-action="Details" asp-route-slug="rent-payments">Rent Payments</a>
                                                <a class="dropdown-item" asp-controller="Resources" asp-action="Details" asp-route-slug="reviews-and-ratings">Reviews &amp; Ratings</a>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <hr class="dropdown-divider" />
                                <a class="dropdown-item" asp-controller="Resources" asp-action="Details" asp-route-slug="how-it-works">How It Works</a>
                                <a class="dropdown-item" asp-controller="Resources" asp-action="Index">All Features</a>
                            </div>
                        </li>
                        @if (User.IsInRole("Landlord"))
                        {
                            <li class="nav-item">
                                <a class="@navClass("Landlord", "Index")" asp-area="" asp-controller="Landlord" asp-action="Index">Dashboard</a>
                            </li>
                        }
                        else if (User.IsInRole("Tenant"))
                        {
                            <li class="nav-item">
                                <a class="@navClass("Tenant", "Index")" asp-area="" asp-controller="Tenant" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="@navClass("Booking", "Browse")" asp-area="" asp-controller="Booking" asp-action="Browse">Browse &amp; Book</a>
                            </li>
                            <li class="nav-item">
                                <a class="@navClass("Booking", "MyBookings")" asp-area="" asp-controller="Booking" asp-action="MyBookings">My Bookings</a>
                            </li>
                            <li class="nav-item">
                                <a class="@navClass("Mess", "Index")" asp-area="" asp-controller="Mess" asp-action="Index">Mess Menu</a>
                            </li>
                            <li class="nav-item">
                                <a class="@navClass("Maintenance", "MyRequests")" asp-area="" asp-controller="Maintenance" asp-action="MyRequests">Maintenance</a>
                            </li>
                            <li class="nav-item">
                                <a class="@navClass("Review", "MyReviews")" asp-area="" asp-controller="Review" asp-action="MyReviews">My Reviews</a>
                            </li>
                        }
                        else if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="@navClass("Admin", "Index")" asp-area="" asp-controller="Admin" asp-action="Index">Dashboard</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var currentUserId = UserManager.GetUserId(User);
                            var unreadCount = await DbContext.Notifications.CountAsync(n => n.RecipientId == currentUserId && !n.IsRead);
                            var currentUser = await UserManager.FindByIdAsync(currentUserId!);
                            var displayName = string.IsNullOrWhiteSpace(currentUser?.FullName) ? User.Identity.Name : currentUser.FullName;
                            <li class="nav-item">
                                <a class="@navClass("Notification", "Index")" asp-area="" asp-controller="Notification" asp-action="Index">
                                    <i class="bi bi-bell"></i> Notifications
                                    @if (unreadCount > 0)
                                    {
                                        <span class="badge text-bg-danger rounded-pill">@unreadCount</span>
                                    }
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i> @displayName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Settings">Settings</a></li>
                                    @if (User.IsInRole("Landlord"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Subscription" asp-action="Index">My Subscription</a></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item ms-sm-2">
                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container page-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4 footer-top">
                <div class="col-lg-4 col-md-12">
                    <a class="footer-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect class="mark-bg" x="1" y="1" width="22" height="22" rx="6" fill="var(--brand)" />
                            <path class="mark-house" d="M12 5 18 10.2V18H6v-7.8Z" fill="#ffffff" />
                            <rect class="mark-door" x="10" y="13" width="4" height="5" rx="1" fill="var(--brand)" />
                        </svg>
                        RehLe
                    </a>
                    <p class="footer-tagline">One flat monthly price, unlimited properties. Rent collection, utility splitting, maintenance tracking, and bookings &mdash; all in one place.</p>
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <h6 class="footer-heading">Product</h6>
                    <ul class="footer-links">
                        <li><a asp-area="" asp-controller="Home" asp-action="Listings">Browse Listings</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Pricing">Pricing</a></li>
                        <li><a asp-area="" asp-controller="Resources" asp-action="Index">Features</a></li>
                        <li><a asp-area="" asp-controller="Resources" asp-action="Details" asp-route-slug="how-it-works">How It Works</a></li>
                    </ul>
                </div>
                @{
                    var isLandlordUser = User.IsInRole("Landlord");
                    var isTenantUser = User.IsInRole("Tenant");
                }
                @if (showLandlordFeatures)
                {
                    <div class="col-6 col-md-3 col-lg-2">
                        <h6 class="footer-heading">For Landlords</h6>
                        <ul class="footer-links">
                            @if (isLandlordUser)
                            {
                                <li><a asp-area="" asp-controller="Landlord" asp-action="Index">Overview</a></li>
                                <li><a asp-area="" asp-controller="Property" asp-action="Index">Property Listings</a></li>
                                <li><a asp-area="" asp-controller="Landlord" asp-action="Index">Rent Collection</a></li>
                                <li><a asp-area="" asp-controller="UtilityBill" asp-action="Index">Utility Bill Splitting</a></li>
                                <li><a asp-area="" asp-controller="Maintenance" asp-action="Index">Maintenance Tracking</a></li>
                            }
                            else
                            {
                                <li><a asp-area="" asp-controller="Resources" asp-action="Details" asp-route-slug="for-landlords">Overview</a></li>
                                <li><a asp-area="" asp-controller="Resources" asp-action="Details" asp-route-slug="property-listings">Property Listings</a></li>
                                <li><a asp-area="" asp-controller="Resources" asp-action="Details" asp-route-slug="rent-collection">Rent Collection</a></li>
                                <li><a asp-area="" asp-controller="Resources" asp-action="Details" asp-route-slug="utility-bill-splitting">Utility Bill Splitting</a></li>
                                <li><a asp-area="" asp-controller="Resources" asp-action="Details" asp-route-slug="maintenance-tracking">Maintenance Tracking</a></li>
                            }
                        </ul>
                    </div>
                }
                @if (showTenantFeatures)
                {
                    <div class="col-6 col-md-3 col-lg-2">
                        <h6 class="footer-heading">For Tenants</h6>
                        <ul class="footer-links">
                            @if (isTenantUser)
                            {
                                <li><a asp-area="" asp-controller="Tenant" asp-action="Index">Overview</a></li>
                                <li><a asp-area="" asp-controller="Booking" asp-action="Browse">Search &amp; Booking</a></li>
                                <li><a asp-area="" asp-controller="Tenant" asp-action="Index">Rent Payments</a></li>
                                <li><a asp-area="" asp-controller="Review" asp-action="MyReviews">Reviews &amp; Ratings</a></li>
                            }
                            else
                            {
                                <li><a asp-area="" asp-controller="Resources" asp-action="Details" asp-route-slug="for-tenants">Overview</a></li>
                                <li><a asp-area="" asp-controller="Resources" asp-action="Details" asp-route-slug="search-and-booking">Search &amp; Booking</a></li>
                                <li><a asp-area="" asp-controller="Resources" asp-action="Details" asp-route-slug="rent-payments">Rent Payments</a></li>
                                <li><a asp-area="" asp-controller="Resources" asp-action="Details" asp-route-slug="reviews-and-ratings">Reviews &amp; Ratings</a></li>
                            }
                        </ul>
                    </div>
                }
                <div class="col-6 col-md-3 col-lg-2">
                    <h6 class="footer-heading">Account</h6>
                    <ul class="footer-links">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Landlord"))
                            {
                                <li><a asp-area="" asp-controller="Landlord" asp-action="Index">Dashboard</a></li>
                            }
                            else if (User.IsInRole("Tenant"))
                            {
                                <li><a asp-area="" asp-controller="Tenant" asp-action="Index">Dashboard</a></li>
                            }
                            else if (User.IsInRole("Admin"))
                            {
                                <li><a asp-area="" asp-controller="Admin" asp-action="Index">Dashboard</a></li>
                            }
                            <li><a asp-area="" asp-controller="Account" asp-action="Profile">Profile</a></li>
                        }
                        else
                        {
                            <li><a asp-area="" asp-controller="Account" asp-action="Login">Login</a></li>
                            <li><a asp-area="" asp-controller="Account" asp-action="Register">Register</a></li>
                        }
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; @DateTime.Now.Year RehLe. All rights reserved.</span>
                <span class="footer-bottom-links">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    <a asp-area="" asp-controller="Home" asp-action="Pricing">Pricing</a>
                    <a asp-area="" asp-controller="Resources" asp-action="Index">Features</a>
                </span>
            </div>
        </div>
    </footer>

    <div class="modal fade" id="confirmActionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmActionModalTitle">Are you sure?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="confirmActionModalBody"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="confirmActionModalConfirm">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="photoLightbox" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-dark">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close" style="z-index: 1;"></button>
                <img id="photoLightboxImage" src="" class="w-100" style="max-height: 80vh; object-fit: contain;" alt="Photo" />
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/address-autocomplete.js" asp-append-version="true"></script>
    <script src="~/js/cascading-select.js" asp-append-version="true"></script>
    <script src="~/js/confirm-action.js" asp-append-version="true"></script>
    <script src="~/js/photo-lightbox.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

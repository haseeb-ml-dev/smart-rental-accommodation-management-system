@model HomeStatsViewModel
@{
    ViewData["Title"] = "Rental & accommodation management";
}

<div class="hero mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <h1 class="display-5 fw-bold mb-3 lh-sm">
                Manage properties.<br />
                <span class="two-tone">Collect rent on time.</span>
            </h1>
            <p class="fs-5 mb-4">
                One flat monthly price, unlimited properties. List units, screen bookings, collect rent, split
                utility bills, and track maintenance &mdash; all in one place.
            </p>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg fw-semibold">Get started</a>
                <a asp-controller="Home" asp-action="Pricing" class="btn btn-outline-light btn-lg">View pricing</a>
            </div>
            <a asp-controller="Home" asp-action="Listings" class="text-white text-decoration-none small">
                Looking for a place to rent? <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="col-lg-4">
            <div class="hero-stats">
                <div class="hero-stat">
                    <div class="hero-stat-value">@Model.TotalUnits</div>
                    <div class="hero-stat-label">@(Model.TotalUnits == 1 ? "unit listed" : "units listed")</div>
                </div>
                @if (Model.TotalCities > 0)
                {
                    <div class="hero-stat">
                        <div class="hero-stat-value">@Model.TotalCities</div>
                        <div class="hero-stat-label">@(Model.TotalCities == 1 ? "city covered" : "cities covered")</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-5 text-center">
    <div class="col-sm-6 col-lg-3">
        <div class="feature-icon mx-auto"><i class="bi bi-grid-1x2"></i></div>
        <h3 class="h6 fw-bold mb-1">All-in-one platform</h3>
        <p class="text-muted small mb-0">Listings, bookings, leases, rent, and maintenance in a single dashboard.</p>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="feature-icon mx-auto"><i class="bi bi-cash-coin"></i></div>
        <h3 class="h6 fw-bold mb-1">Direct rent tracking</h3>
        <p class="text-muted small mb-0">Tenants mark payments made, landlords confirm &mdash; disputes never get lost.</p>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="feature-icon mx-auto"><i class="bi bi-people"></i></div>
        <h3 class="h6 fw-bold mb-1">Built for both sides</h3>
        <p class="text-muted small mb-0">A dedicated experience for landlords and for tenants, not a bolted-on afterthought.</p>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="feature-icon mx-auto"><i class="bi bi-tools"></i></div>
        <h3 class="h6 fw-bold mb-1">Maintenance tracking</h3>
        <p class="text-muted small mb-0">Issues reported with photos, tracked through to resolved.</p>
    </div>
</div>

<div class="text-center mb-4">
    <h2 class="fw-bold">We&rsquo;re making renting <span class="two-tone">better for everyone</span></h2>
    <p class="text-muted">Real tools for the day-to-day of renting &mdash; not just a listings board.</p>
</div>

<div class="row g-5 mb-5">
    <div class="col-md-6">
        <h3 class="h5 fw-bold mb-3">Landlords &amp; Agents</h3>
        <ul class="checklist">
            <li class="checklist-item"><span class="checklist-item-icon"><i class="bi bi-check-lg"></i></span><span>List unlimited properties and units for one flat monthly price</span></li>
            <li class="checklist-item"><span class="checklist-item-icon"><i class="bi bi-check-lg"></i></span><span>Collect and track rent payments with a confirm/dispute flow</span></li>
            <li class="checklist-item"><span class="checklist-item-icon"><i class="bi bi-check-lg"></i></span><span>Split utility bills equally, by percentage, or by per-meter usage</span></li>
            <li class="checklist-item"><span class="checklist-item-icon"><i class="bi bi-check-lg"></i></span><span>Review and approve booking requests before a lease is created</span></li>
            <li class="checklist-item"><span class="checklist-item-icon"><i class="bi bi-check-lg"></i></span><span>Track maintenance requests from report to resolved</span></li>
            <li class="checklist-item"><span class="checklist-item-icon"><i class="bi bi-check-lg"></i></span><span>See tenant reviews and ratings on your own properties</span></li>
            <li class="checklist-item"><span class="checklist-item-icon"><i class="bi bi-check-lg"></i></span><span>Get notified in-app and by email for everything that needs attention</span></li>
            <li class="checklist-item"><span class="checklist-item-icon"><i class="bi bi-check-lg"></i></span><span>Start with a 30-day free trial, no card required</span></li>
        </ul>
        <a asp-controller="Resources" asp-action="Details" asp-route-slug="for-landlords" class="fw-semibold text-decoration-none">Learn more <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="col-md-6">
        <h3 class="h5 fw-bold mb-3">Tenants</h3>
        <ul class="checklist">
            <li class="checklist-item"><span class="checklist-item-icon"><i class="bi bi-check-lg"></i></span><span>Search by city, then narrow down to the exact area you want</span></li>
            <li class="checklist-item"><span class="checklist-item-icon"><i class="bi bi-check-lg"></i></span><span>See the precise location on a map before you contact anyone</span></li>
            <li class="checklist-item"><span class="checklist-item-icon"><i class="bi bi-check-lg"></i></span><span>Pay rent online and keep a timestamped record of every payment</span></li>
            <li class="checklist-item"><span class="checklist-item-icon"><i class="bi bi-check-lg"></i></span><span>Split shared utility bills fairly with roommates</span></li>
            <li class="checklist-item"><span class="checklist-item-icon"><i class="bi bi-check-lg"></i></span><span>Report maintenance issues with a photo and track their status</span></li>
            <li class="checklist-item"><span class="checklist-item-icon"><i class="bi bi-check-lg"></i></span><span>Read real reviews from tenants who've actually lived there</span></li>
            <li class="checklist-item"><span class="checklist-item-icon"><i class="bi bi-check-lg"></i></span><span>Leave your own review once your lease has run its course</span></li>
            <li class="checklist-item"><span class="checklist-item-icon"><i class="bi bi-check-lg"></i></span><span>Completely free &mdash; no account fee, ever</span></li>
        </ul>
        <a asp-controller="Resources" asp-action="Details" asp-route-slug="for-tenants" class="fw-semibold text-decoration-none">Learn more <i class="bi bi-arrow-right"></i></a>
    </div>
</div>

<div class="row justify-content-center my-5">
    <div class="col-lg-8">
        <h2 class="h4 mb-3 text-center">Frequently asked questions</h2>
        <div class="accordion" id="homeFaq">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#hfaq1">
                        How much does RehLe cost?
                    </button>
                </h2>
                <div id="hfaq1" class="accordion-collapse collapse" data-bs-parent="#homeFaq">
                    <div class="accordion-body">
                        Landlords get a free first month, then a small flat monthly subscription, unlimited properties
                        included. It's always free for tenants. See the full breakdown on our
                        <a asp-controller="Home" asp-action="Pricing">Pricing</a> page.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#hfaq2">
                        How do rent payments work?
                    </button>
                </h2>
                <div id="hfaq2" class="accordion-collapse collapse" data-bs-parent="#homeFaq">
                    <div class="accordion-body">A tenant marks an invoice paid (optionally attaching a payment slip), and the landlord confirms it was received. If either side disagrees, a dispute opens automatically so it's never just left hanging.</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#hfaq3">
                        Can I split utility bills between roommates?
                    </button>
                </h2>
                <div id="hfaq3" class="accordion-collapse collapse" data-bs-parent="#homeFaq">
                    <div class="accordion-body">Yes &mdash; equally, by custom percentage, or by per-meter consumption, and tenants with their own meter are automatically excluded from the shared split.</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#hfaq4">
                        Where can I learn more about specific features?
                    </button>
                </h2>
                <div id="hfaq4" class="accordion-collapse collapse" data-bs-parent="#homeFaq">
                    <div class="accordion-body">Our <a asp-controller="Resources" asp-action="Index">Features</a> section covers exactly what's included for landlords and for tenants.</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="cta-band mb-4">
    <h2 class="h3 fw-bold mb-2">Ready to list your property?</h2>
    <p class="mb-4">Join RehLe and start collecting rent, managing tenants, and tracking maintenance in one place.</p>
    <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg fw-semibold">Get started free</a>
</div>

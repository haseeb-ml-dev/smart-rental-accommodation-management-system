@model List<InfoPage>
@{
    ViewData["Title"] = "Manage Resources";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Resources</h1>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">New Page</a>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-link">Back to Dashboard</a>
    </div>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var article in Model)
            {
                <tr>
                    <td>@article.Title</td>
                    <td>@article.Category.Humanize()</td>
                    <td>
                        @if (article.IsPublished)
                        {
                            <span class="badge text-bg-success">Published</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Draft</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@article.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@article.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    data-confirm-title="Delete this page?"
                                    data-confirm-body="This can't be undone.">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="text-muted">No pages yet.</td></tr>
            }
        </tbody>
    </table>
</div>

@model List<InfoPage>
@{
    ViewData["Title"] = "Features";
}

<h1 class="mb-2">Features</h1>
<p class="text-muted mb-4">Everything RehLe does for landlords and for tenants, in plain terms.</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No pages published yet — check back soon.</div>
}

@foreach (var group in Model.GroupBy(p => p.Category).OrderBy(g => g.Key))
{
    <h2 class="h5 mb-3">@group.Key.Humanize()</h2>
    <div class="row g-4 mb-5">
        @foreach (var article in group)
        {
            <div class="col-md-6 col-lg-4">
                <a asp-action="Details" asp-route-slug="@article.Slug" class="text-decoration-none text-body">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <div class="feature-page-icon mb-3"><i class="bi bi-check2-circle"></i></div>
                            <h5 class="card-title mb-2">@article.Title</h5>
                            <p class="text-muted small flex-grow-1">@article.Excerpt</p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

@model InfoPage
@{
    ViewData["Title"] = Model.Title;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <a asp-action="Index" class="btn btn-link ps-0 mb-3">&larr; Back to Features</a>
        <img src="@ViewBag.HeroImage" alt="" class="feature-hero-image" />
        <div class="text-muted small text-uppercase fw-semibold mb-2">@Model.Category.Humanize()</div>
        <h1 class="mb-4">@Model.Title</h1>
        <div class="feature-article">
            @foreach (var paragraph in Model.Content.Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries))
            {
                <p>@paragraph.Trim()</p>
            }
        </div>
        @if (ViewBag.CtaController != null)
        {
            <a asp-controller="@ViewBag.CtaController" asp-action="@ViewBag.CtaAction" class="btn btn-primary mt-2">
                @ViewBag.CtaText <i class="bi bi-arrow-right"></i>
            </a>
        }
    </div>
</div>

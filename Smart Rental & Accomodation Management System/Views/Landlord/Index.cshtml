@model LandlordDashboardViewModel
@{
    ViewData["Title"] = "Landlord Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Landlord Dashboard</h1>
    <div class="d-flex gap-2">
        <a asp-controller="Property" asp-action="Index" class="btn btn-outline-primary">My Properties</a>
        <a asp-controller="Booking" asp-action="Requests" class="btn btn-outline-primary">Booking Requests</a>
        <a asp-controller="UtilityBill" asp-action="Index" class="btn btn-outline-primary">Utility Bills</a>
        <a asp-action="ExportExcel" class="btn btn-outline-secondary">Export Excel</a>
        <a asp-action="ExportPdf" class="btn btn-outline-secondary">Export PDF</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-tile h-100">
            <div class="stat-tile-icon stat-tile-icon-primary"><i class="bi bi-building"></i></div>
            <div class="stat-tile-body">
                <div class="stat-tile-label">Properties</div>
                <div class="stat-tile-value">@Model.TotalProperties</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-tile h-100">
            <div class="stat-tile-icon stat-tile-icon-info"><i class="bi bi-door-open"></i></div>
            <div class="stat-tile-body">
                <div class="stat-tile-label">Units (occupied / vacant)</div>
                <div class="stat-tile-value">@Model.TotalUnits</div>
                <div class="stat-tile-sub">@Model.OccupiedUnits occupied &middot; @Model.VacantUnits vacant</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-tile h-100">
            <div class="stat-tile-icon stat-tile-icon-success"><i class="bi bi-cash-coin"></i></div>
            <div class="stat-tile-body">
                <div class="stat-tile-label">Collected this month</div>
                <div class="stat-tile-value text-success">@Model.CollectedThisMonth.ToString("C")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <a asp-action="OverdueTenants" class="stat-tile h-100">
            <div class="stat-tile-icon @(Model.OverdueInvoiceCount > 0 ? "stat-tile-icon-danger" : "stat-tile-icon-secondary")"><i class="bi bi-exclamation-circle"></i></div>
            <div class="stat-tile-body">
                <div class="stat-tile-label">Overdue invoices</div>
                <div class="stat-tile-value @(Model.OverdueInvoiceCount > 0 ? "text-danger" : "")">@Model.OverdueInvoiceCount</div>
                <div class="stat-tile-sub">Outstanding: @Model.OutstandingThisMonth.ToString("C")</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-tile h-100">
            <div class="stat-tile-icon @(Model.OutstandingUtilities > 0 ? "stat-tile-icon-warning" : "stat-tile-icon-secondary")"><i class="bi bi-lightning-charge"></i></div>
            <div class="stat-tile-body">
                <div class="stat-tile-label">Outstanding utility bills</div>
                <div class="stat-tile-value @(Model.OutstandingUtilities > 0 ? "text-danger" : "")">@Model.OutstandingUtilities.ToString("C")</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Collection history (last 6 months)</h5>
        <canvas id="collectionChart" height="90"></canvas>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Recent invoices</h5>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Tenant</th>
                        <th>Unit</th>
                        <th>Period</th>
                        <th>Amount</th>
                        <th>Due date</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in Model.RecentInvoices)
                    {
                        <tr>
                            <td>@invoice.Lease?.Tenant?.FullName</td>
                            <td>@invoice.Lease?.Unit?.Name</td>
                            <td>@invoice.PeriodMonth/@invoice.PeriodYear</td>
                            <td>@invoice.Amount.ToString("C")</td>
                            <td>@invoice.DueDate.ToString("MMM d, yyyy")</td>
                            <td>
                                @{
                                    var badgeClass = invoice.Status switch
                                    {
                                        InvoiceStatus.Paid => "text-bg-success",
                                        InvoiceStatus.Overdue => "text-bg-danger",
                                        _ => "text-bg-warning"
                                    };
                                }
                                <span class="badge @badgeClass">@invoice.Status.Humanize()</span>
                            </td>
                            <td>
                                @if (invoice.Status != InvoiceStatus.Paid)
                                {
                                    @if (invoice.TenantMarkedPaidAt != null)
                                    {
                                        <div class="small text-info mb-1">
                                            Tenant marked paid @invoice.TenantMarkedPaidAt.Value.ToString("MMM d")
                                            @if (invoice.PaymentSlipFileName != null)
                                            {
                                                <a href="/uploads/payment-slips/rent/@invoice.Id/@invoice.PaymentSlipFileName" target="_blank" rel="noopener">(view slip)</a>
                                            }
                                        </div>
                                    }
                                    <form asp-action="MarkInvoicePaid" method="post">
                                        <input type="hidden" name="invoiceId" value="@invoice.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">Mark paid</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.RecentInvoices.Any())
                    {
                        <tr><td colspan="7" class="text-muted">No invoices yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script>
        const ctx = document.getElementById('collectionChart');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.MonthlyCollection.Select(m => m.Label))),
                datasets: [
                    {
                        label: 'Collected',
                        data: @Html.Raw(Json.Serialize(Model.MonthlyCollection.Select(m => m.Collected))),
                        backgroundColor: '#198754'
                    },
                    {
                        label: 'Outstanding',
                        data: @Html.Raw(Json.Serialize(Model.MonthlyCollection.Select(m => m.Outstanding))),
                        backgroundColor: '#dc3545'
                    }
                ]
            },
            options: {
                responsive: true,
                scales: { y: { beginAtZero: true } }
            }
        });
    </script>
}

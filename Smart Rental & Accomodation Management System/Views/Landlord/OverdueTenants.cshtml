@model List<OverdueTenantGroupViewModel>
@{
    ViewData["Title"] = "Overdue Tenants";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Overdue Tenants</h1>
    <a asp-action="Index" class="btn btn-link">Back to Dashboard</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-success">No overdue tenants right now.</div>
}

@foreach (var group in Model)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <h5 class="card-title mb-1">@group.TenantName</h5>
                    <div class="text-muted small">@group.PropertyName@(string.IsNullOrEmpty(group.UnitName) ? "" : $" · {group.UnitName}")</div>
                </div>
                <div class="fs-5 fw-semibold text-danger">@group.TotalOverdue.ToString("C")</div>
            </div>

            @if (group.OverdueInvoices.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-2">
                        <thead><tr><th>Rent period</th><th>Amount</th><th>Due date</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var invoice in group.OverdueInvoices)
                            {
                                <tr>
                                    <td>@invoice.PeriodMonth/@invoice.PeriodYear</td>
                                    <td>@invoice.Amount.ToString("C")</td>
                                    <td>@invoice.DueDate.ToString("MMM d, yyyy")</td>
                                    <td>
                                        @if (invoice.TenantMarkedPaidAt != null)
                                        {
                                            <div class="small text-info mb-1">
                                                Tenant marked paid
                                                @if (invoice.PaymentSlipFileName != null)
                                                {
                                                    <a href="/uploads/payment-slips/rent/@invoice.Id/@invoice.PaymentSlipFileName" target="_blank" rel="noopener">(view slip)</a>
                                                }
                                            </div>
                                        }
                                        @if (invoice.DisputeStatus == DisputeStatus.Open)
                                        {
                                            <span class="badge text-bg-danger">Dispute open &mdash; resolve from Dashboard</span>
                                        }
                                        else
                                        {
                                            <div class="d-flex gap-1">
                                                <form asp-action="MarkInvoicePaid" method="post">
                                                    <input type="hidden" name="invoiceId" value="@invoice.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success"
                                                            data-confirm-title="Confirm this payment was received?"
                                                            data-confirm-body="This marks the invoice paid and notifies the tenant.">Confirm received</button>
                                                </form>
                                                @if (invoice.TenantMarkedPaidAt != null)
                                                {
                                                    <form asp-action="RejectInvoicePayment" method="post">
                                                        <input type="hidden" name="invoiceId" value="@invoice.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                                data-confirm-title="Mark this payment as not received?"
                                                                data-confirm-body="This opens a dispute and notifies the tenant.">Not received</button>
                                                    </form>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (group.OverdueUtilityShares.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Utility bill</th><th>Share</th><th>Due date</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var share in group.OverdueUtilityShares)
                            {
                                <tr>
                                    <td>@share.UtilityBill!.BillType.Humanize() (@share.UtilityBill.PeriodMonth/@share.UtilityBill.PeriodYear)</td>
                                    <td>@share.ShareAmount.ToString("C")</td>
                                    <td>@share.UtilityBill.DueDate.ToString("MMM d, yyyy")</td>
                                    <td>
                                        @if (share.TenantMarkedPaidAt != null)
                                        {
                                            <div class="small text-info mb-1">
                                                Tenant marked paid
                                                @if (share.PaymentSlipFileName != null)
                                                {
                                                    <a href="/uploads/payment-slips/utility/@share.Id/@share.PaymentSlipFileName" target="_blank" rel="noopener">(view slip)</a>
                                                }
                                            </div>
                                        }
                                        @if (share.DisputeStatus == DisputeStatus.Open)
                                        {
                                            <span class="badge text-bg-danger">Dispute open &mdash; resolve from Utility Bills</span>
                                        }
                                        else
                                        {
                                            <div class="d-flex gap-1">
                                                <form asp-controller="UtilityBill" asp-action="MarkSharePaid" method="post">
                                                    <input type="hidden" name="shareId" value="@share.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success"
                                                            data-confirm-title="Confirm this payment was received?"
                                                            data-confirm-body="This marks the share paid and notifies the tenant.">Confirm received</button>
                                                </form>
                                                @if (share.TenantMarkedPaidAt != null)
                                                {
                                                    <form asp-controller="UtilityBill" asp-action="RejectSharePayment" method="post">
                                                        <input type="hidden" name="shareId" value="@share.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                                data-confirm-title="Mark this payment as not received?"
                                                                data-confirm-body="This opens a dispute and notifies the tenant.">Not received</button>
                                                    </form>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
